{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/nemarOrg/orcid-mock/main/fixtures/users.schema.json",
  "title": "orcid-mock users file",
  "description": "Clients and users for orcid-mock, an ephemeral mock of the Open Researcher and Contributor ID (ORCID) service. Field names transliterate ORCID's own. Rules a JSON Schema cannot express (checksums, duplicates, one primary email) are enforced when the file loads.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "clients": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "client_id": {
            "type": "string",
            "minLength": 1
          },
          "client_secret": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "description": "Shown on the consent page; defaults to the client_id",
            "type": "string"
          },
          "redirect_uris": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri"
            }
          },
          "member": {
            "description": "A member client may read limited items; default false",
            "type": "boolean"
          }
        },
        "required": [
          "client_id",
          "client_secret",
          "redirect_uris"
        ],
        "additionalProperties": false
      }
    },
    "users": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "orcid": {
            "description": "Any block is accepted if the checksum is right; empty or absent mints an iD from the mint block",
            "type": "string",
            "pattern": "^(?:\\d{4}-\\d{4}-\\d{4}-\\d{3}[\\dX])?$"
          },
          "claimed": {
            "description": "Absent means claimed",
            "type": "boolean"
          },
          "locked": {
            "type": "boolean"
          },
          "deactivated": {
            "type": "boolean"
          },
          "deprecated_to": {
            "description": "The primary record this one was merged into",
            "type": "string",
            "pattern": "^(?:\\d{4}-\\d{4}-\\d{4}-\\d{3}[\\dX])?$"
          },
          "name": {
            "type": "object",
            "properties": {
              "given_names": {
                "type": "string",
                "minLength": 1
              },
              "family_name": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "credit_name": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "visibility": {
                "$ref": "#/$defs/Visibility"
              }
            },
            "required": [
              "given_names",
              "visibility"
            ],
            "additionalProperties": false
          },
          "other_names": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "put_code": {
                  "$ref": "#/$defs/PutCode"
                },
                "content": {
                  "type": "string",
                  "minLength": 1
                },
                "visibility": {
                  "$ref": "#/$defs/Visibility"
                },
                "display_index": {
                  "$ref": "#/$defs/DisplayIndex"
                }
              },
              "required": [
                "content",
                "visibility"
              ],
              "additionalProperties": false
            }
          },
          "biography": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "content": {
                    "type": "string",
                    "minLength": 1
                  },
                  "visibility": {
                    "$ref": "#/$defs/Visibility"
                  }
                },
                "required": [
                  "content",
                  "visibility"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "emails": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "email": {
                  "type": "string",
                  "format": "email",
                  "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
                },
                "primary": {
                  "type": "boolean"
                },
                "verified": {
                  "type": "boolean"
                },
                "visibility": {
                  "$ref": "#/$defs/Visibility"
                }
              },
              "required": [
                "email",
                "primary",
                "verified",
                "visibility"
              ],
              "additionalProperties": false
            }
          },
          "addresses": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "put_code": {
                  "$ref": "#/$defs/PutCode"
                },
                "country": {
                  "$ref": "#/$defs/CountryCode"
                },
                "visibility": {
                  "$ref": "#/$defs/Visibility"
                },
                "display_index": {
                  "$ref": "#/$defs/DisplayIndex"
                }
              },
              "required": [
                "country",
                "visibility"
              ],
              "additionalProperties": false
            }
          },
          "keywords": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "put_code": {
                  "$ref": "#/$defs/PutCode"
                },
                "content": {
                  "type": "string",
                  "minLength": 1
                },
                "visibility": {
                  "$ref": "#/$defs/Visibility"
                },
                "display_index": {
                  "$ref": "#/$defs/DisplayIndex"
                }
              },
              "required": [
                "content",
                "visibility"
              ],
              "additionalProperties": false
            }
          },
          "external_identifiers": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "put_code": {
                  "$ref": "#/$defs/PutCode"
                },
                "external_id_type": {
                  "type": "string",
                  "minLength": 1
                },
                "external_id_value": {
                  "type": "string",
                  "minLength": 1
                },
                "external_id_url": {
                  "anyOf": [
                    {
                      "type": "string",
                      "format": "uri"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "external_id_relationship": {
                  "anyOf": [
                    {
                      "type": "string",
                      "enum": [
                        "self",
                        "part-of",
                        "version-of",
                        "funded-by"
                      ]
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "visibility": {
                  "$ref": "#/$defs/Visibility"
                },
                "display_index": {
                  "$ref": "#/$defs/DisplayIndex"
                }
              },
              "required": [
                "external_id_type",
                "external_id_value",
                "visibility"
              ],
              "additionalProperties": false
            }
          },
          "researcher_urls": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "put_code": {
                  "$ref": "#/$defs/PutCode"
                },
                "url_name": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "url": {
                  "type": "string",
                  "format": "uri"
                },
                "visibility": {
                  "$ref": "#/$defs/Visibility"
                },
                "display_index": {
                  "$ref": "#/$defs/DisplayIndex"
                }
              },
              "required": [
                "url",
                "visibility"
              ],
              "additionalProperties": false
            }
          },
          "employments": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/Affiliation"
            }
          },
          "educations": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/Affiliation"
            }
          },
          "qualifications": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/Affiliation"
            }
          },
          "works": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "put_code": {
                  "$ref": "#/$defs/PutCode"
                },
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "subtitle": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "translated_title": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/TranslatedTitle"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "journal_title": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "short_description": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "citation": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "citation_type": {
                          "type": "string",
                          "minLength": 1
                        },
                        "citation_value": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": [
                        "citation_type",
                        "citation_value"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "type": {
                  "type": "string",
                  "pattern": "^[a-z]+(-[a-z]+)*$"
                },
                "publication_date": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/FuzzyDate"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "external_ids": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/ExternalId"
                  }
                },
                "url": {
                  "anyOf": [
                    {
                      "type": "string",
                      "format": "uri"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "contributors": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "contributor_orcid": {
                        "anyOf": [
                          {
                            "type": "string",
                            "pattern": "^\\d{4}-\\d{4}-\\d{4}-\\d{3}[\\dX]$"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "credit_name": {
                        "type": "string",
                        "minLength": 1
                      },
                      "contributor_sequence": {
                        "anyOf": [
                          {
                            "type": "string",
                            "enum": [
                              "first",
                              "additional"
                            ]
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "contributor_role": {
                        "type": [
                          "string",
                          "null"
                        ]
                      }
                    },
                    "required": [
                      "credit_name"
                    ],
                    "additionalProperties": false
                  }
                },
                "language_code": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "country": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/CountryCode"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "visibility": {
                  "$ref": "#/$defs/Visibility"
                },
                "display_index": {
                  "$ref": "#/$defs/DisplayIndex"
                }
              },
              "required": [
                "title",
                "type",
                "visibility"
              ],
              "additionalProperties": false
            }
          },
          "fundings": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "put_code": {
                  "$ref": "#/$defs/PutCode"
                },
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "translated_title": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/TranslatedTitle"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "grant",
                    "contract",
                    "award",
                    "salary-award"
                  ]
                },
                "start_date": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/FuzzyDate"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "end_date": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/FuzzyDate"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "organization": {
                  "$ref": "#/$defs/Organization"
                },
                "external_ids": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/ExternalId"
                  }
                },
                "url": {
                  "anyOf": [
                    {
                      "type": "string",
                      "format": "uri"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "visibility": {
                  "$ref": "#/$defs/Visibility"
                },
                "display_index": {
                  "$ref": "#/$defs/DisplayIndex"
                }
              },
              "required": [
                "title",
                "type",
                "organization",
                "visibility"
              ],
              "additionalProperties": false
            }
          },
          "peer_reviews": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "put_code": {
                  "$ref": "#/$defs/PutCode"
                },
                "reviewer_role": {
                  "type": "string",
                  "enum": [
                    "reviewer",
                    "editor",
                    "member",
                    "chair",
                    "organizer"
                  ]
                },
                "review_type": {
                  "type": "string",
                  "enum": [
                    "review",
                    "evaluation"
                  ]
                },
                "review_url": {
                  "anyOf": [
                    {
                      "type": "string",
                      "format": "uri"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "review_group_id": {
                  "type": "string",
                  "minLength": 1
                },
                "completion_date": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/FuzzyDate"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "convening_organization": {
                  "$ref": "#/$defs/Organization"
                },
                "external_ids": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/ExternalId"
                  }
                },
                "visibility": {
                  "$ref": "#/$defs/Visibility"
                },
                "display_index": {
                  "$ref": "#/$defs/DisplayIndex"
                }
              },
              "required": [
                "reviewer_role",
                "review_type",
                "review_group_id",
                "convening_organization",
                "visibility"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "clients",
    "users"
  ],
  "additionalProperties": false,
  "$defs": {
    "Visibility": {
      "type": "string",
      "enum": [
        "public",
        "limited",
        "private"
      ]
    },
    "PutCode": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "description": "Assigned at load from a counter when omitted; unique within its section"
    },
    "DisplayIndex": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "CountryCode": {
      "type": "string",
      "pattern": "^[A-Z]{2}$"
    },
    "Affiliation": {
      "type": "object",
      "properties": {
        "put_code": {
          "$ref": "#/$defs/PutCode"
        },
        "department_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "role_title": {
          "type": [
            "string",
            "null"
          ]
        },
        "start_date": {
          "anyOf": [
            {
              "$ref": "#/$defs/FuzzyDate"
            },
            {
              "type": "null"
            }
          ]
        },
        "end_date": {
          "anyOf": [
            {
              "$ref": "#/$defs/FuzzyDate"
            },
            {
              "type": "null"
            }
          ]
        },
        "organization": {
          "$ref": "#/$defs/Organization"
        },
        "url": {
          "anyOf": [
            {
              "type": "string",
              "format": "uri"
            },
            {
              "type": "null"
            }
          ]
        },
        "external_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ExternalId"
          }
        },
        "visibility": {
          "$ref": "#/$defs/Visibility"
        },
        "display_index": {
          "$ref": "#/$defs/DisplayIndex"
        }
      },
      "required": [
        "organization",
        "visibility"
      ],
      "additionalProperties": false
    },
    "FuzzyDate": {
      "type": "string",
      "pattern": "^(?:19\\d{2}|20\\d{2}|2100)(?:-(?:0[1-9]|1[0-2])(?:-(?:0[1-9]|[12]\\d|3[01]))?)?$"
    },
    "Organization": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "address": {
          "type": "object",
          "properties": {
            "city": {
              "type": "string",
              "minLength": 1
            },
            "region": {
              "type": [
                "string",
                "null"
              ]
            },
            "country": {
              "$ref": "#/$defs/CountryCode"
            }
          },
          "required": [
            "city",
            "country"
          ],
          "additionalProperties": false
        },
        "disambiguated_organization": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "disambiguated_organization_identifier": {
                  "type": "string",
                  "minLength": 1
                },
                "disambiguation_source": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "disambiguated_organization_identifier",
                "disambiguation_source"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "name",
        "address"
      ],
      "additionalProperties": false
    },
    "ExternalId": {
      "type": "object",
      "properties": {
        "external_id_type": {
          "type": "string",
          "minLength": 1
        },
        "external_id_value": {
          "type": "string",
          "minLength": 1
        },
        "external_id_url": {
          "anyOf": [
            {
              "type": "string",
              "format": "uri"
            },
            {
              "type": "null"
            }
          ]
        },
        "external_id_relationship": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "self",
                "part-of",
                "version-of",
                "funded-by"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "external_id_type",
        "external_id_value"
      ],
      "additionalProperties": false
    },
    "TranslatedTitle": {
      "type": "object",
      "properties": {
        "value": {
          "type": "string",
          "minLength": 1
        },
        "language_code": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "value",
        "language_code"
      ],
      "additionalProperties": false
    }
  }
}
