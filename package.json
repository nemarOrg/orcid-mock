{
  "name": "@nemarorg/orcid-mock",
  "version": "0.0.0",
  "description": "An ephemeral mock of the ORCID OAuth, OpenID Connect, and public record API for tests and CI, with users defined in JSON",
  "license": "MIT",
  "private": false,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.4"
  },
  "bin": {
    "orcid-mock": "src/main.ts"
  },
  "scripts": {
    "lint": "biome ci .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.portable.json",
    "test": "bun test --coverage",
    "schema": "bun run src/main.ts schema --out fixtures/users.schema.json",
    "example": "bun scripts/write-example.ts"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nemarOrg/orcid-mock"
  },
  "keywords": [
    "orcid",
    "mock",
    "oauth2",
    "openid-connect",
    "testing",
    "ci"
  ],
  "dependencies": {
    "hono": "4.13.12",
    "jose": "6.2.12",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/bun": "1.4.2",
    "typescript": "7.0.2"
  }
}
